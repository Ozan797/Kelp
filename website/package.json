{
  "name": "bucket-browser-website",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/render.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test --experimental-strip-types tests/path.test.ts tests/release.test.ts tests/notes.test.ts ../design/theme.test.ts && node ../design/check-contrast.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^8.3.4"
  }
}
