{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelp",
  "version": "0.1.2",
  "identifier": "dev.ozanai.kelp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/entitlements.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kelp",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: kelp-preview:; media-src kelp-preview:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost kelp-preview:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Kelp.entitlements",
      "files": {
        "embedded.provisionprofile": "Kelp.provisionprofile"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://kelp-dl.ozanai.dev/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MjgwM0ExNUVBNjUzQ0IKUldUTFU2WmVvUU1vbHlSVzZzNENLQkVmU3UvR2E1VTlOQ2dScGZ3TVZ1SldsV0Y3RDh2THRuVlcK"
    }
  }
}
